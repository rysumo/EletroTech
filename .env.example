# Supabase Configuration (Automatic on Vercel via Marketplace Integration)
# For local development, copy to .env and fill with your Supabase project credentials:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server settings
PORT=3000
JWT_SECRET=your-jwt-secret-key
